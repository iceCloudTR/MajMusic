<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:theme="using:MajMusic.Presentation.Theme">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MusicCanvasBrush" Color="#141416" />
                    <SolidColorBrush x:Key="MusicPanelBrush" Color="#1C1C1F" />
                    <SolidColorBrush x:Key="MusicRaisedBrush" Color="#27272C" />
                    <SolidColorBrush x:Key="MusicLineBrush" Color="#36363D" />
                    <SolidColorBrush x:Key="MusicTextBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="MusicMutedBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="#8B8CF8" />
                    <SolidColorBrush x:Key="MusicAccentTextBrush" Color="#161625" />
                    <SolidColorBrush x:Key="MusicSelectionBrush" Color="#2D2B48" />
                    <SolidColorBrush x:Key="MusicDownloadBrush" Color="#35353D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MusicCanvasBrush" Color="#F5F5F7" />
                    <SolidColorBrush x:Key="MusicPanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MusicRaisedBrush" Color="#EEEEF1" />
                    <SolidColorBrush x:Key="MusicLineBrush" Color="#DCDCE2" />
                    <SolidColorBrush x:Key="MusicTextBrush" Color="#202024" />
                    <SolidColorBrush x:Key="MusicMutedBrush" Color="#66666F" />
                    <SolidColorBrush x:Key="MusicAccentBrush" Color="#5B5BD6" />
                    <SolidColorBrush x:Key="MusicAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MusicSelectionBrush" Color="#EBEAFB" />
                    <SolidColorBrush x:Key="MusicDownloadBrush" Color="#E3E3EA" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <Style Selector="UserControl">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="arc|Button">
        <Setter Property="Variant" Value="Secondary" />
        <Setter Property="Size" Value="Small" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsPressScaleEnabled" Value="True" />
        <Setter Property="LabelSwapMode" Value="Label" />
    </Style>
    <Style Selector="arc|Button.primary">
        <Setter Property="Variant" Value="Primary" />
        <Setter Property="Background" Value="{DynamicResource MusicAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MusicAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="arc|Button.quiet">
        <Setter Property="Variant" Value="Ghost" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="arc|Button.navigation">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="arc|Button.navigation.current">
        <Setter Property="Foreground" Value="{DynamicResource MusicAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource MusicSelectionBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="arc|Button.icon">
        <Setter Property="Variant" Value="Ghost" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="arc|Button.iconSmall, arc|Button.page">
        <Setter Property="Variant" Value="Ghost" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="arc|Button.transport">
        <Setter Property="Variant" Value="Ghost" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="arc|Button.transportPrimary">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.modeGlyph">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource MusicMutedBrush}" />
    </Style>
    <Style Selector="Path.modeGlyph.active">
        <Setter Property="Stroke" Value="{DynamicResource MusicAccentBrush}" />
    </Style>
    <Style Selector="arc|Input, arc|SearchField">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Size" Value="Small" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="arc|Select">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Size" Value="Small" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="arc|Slider">
        <Setter Property="ThumbDiameter" Value="16" />
        <Setter Property="TrackThickness" Value="4" />
    </Style>
    <Style Selector="TabControl.desktopPages">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="0,*">
                    <ItemsPresenter Name="PART_ItemsPresenter" Height="0" Opacity="0" ClipToBounds="True"
                                    IsHitTestVisible="False" ItemsPanel="{TemplateBinding ItemsPanel}"
                                    KeyboardNavigation.TabNavigation="None" />
                    <theme:MusicSurfaceHost Name="PageSurfaceTransition" Grid.Row="1"
                                            ChangeVersion="{TemplateBinding SelectedIndex}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ContentPresenter Name="PART_SelectedContentHost"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </theme:MusicSurfaceHost>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MusicSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MusicTextBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MusicSelectionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MusicTextBrush}" />
    </Style>
    <Style Selector="ListBox#PlaylistList ListBoxItem">
        <Setter Property="Padding" Value="10,0" />
    </Style>
</Styles>
