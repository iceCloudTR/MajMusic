<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:converters="using:MajMusic.Presentation.Converters"
             x:Class="MajMusic.Presentation.Views.EndpointCardView"
             x:DataType="vm:EndpointCardViewModel">
    <Border x:Name="EndpointCardPanel" Classes="card" Height="232" Padding="14">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
            <Grid x:Name="EndpointEditorPanel" RowDefinitions="26,36,36,36,36" RowSpacing="8" VerticalAlignment="Top">
                <Grid ColumnDefinitions="*,26" ColumnSpacing="8">
                    <TextBlock Text="接入点" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <arc:Button x:Name="RemoveEndpointButton" Grid.Column="1" Classes="quiet" Variant="Ghost" IsPressScaleEnabled="False" Width="26" Height="26" MinHeight="0" Padding="6"
                            Command="{Binding RemoveEndpointCommand}" ToolTip.Tip="移除接入点" AutomationProperties.Name="移除接入点">
                        <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Width="12" Height="12" Stretch="None" Stroke="{DynamicResource MusicMutedBrush}" StrokeThickness="1.5" />
                    </arc:Button>
                </Grid>
                <arc:Input x:Name="EndpointNameEditor" Grid.Row="1" Text="{Binding EndpointName, Mode=TwoWay}" Placeholder="名称" Size="Small" Height="36" IsEnabled="{Binding IsIdle}" />
                <arc:Input x:Name="EndpointUrlEditor" Grid.Row="2" Text="{Binding EndpointUrl, Mode=TwoWay}" Placeholder="API 地址" Size="Small" Height="36" IsEnabled="{Binding IsIdle}" />
                <arc:Checkbox x:Name="UseCloudCollectionsToggle" Grid.Row="3" IsChecked="{Binding UseCloudCollections, Mode=TwoWay}"
                          IsEnabled="{Binding CanUseCloudCollections}" MinHeight="36" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="使用此接入点的收藏夹" FontSize="12" TextTrimming="CharacterEllipsis" />
                </arc:Checkbox>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
                    <arc:Button Content="保存" Variant="Secondary" Size="Small" Height="36" Command="{Binding SaveEndpointCommand}" />
                    <arc:Button Content="同步" Variant="Secondary" Size="Small" Height="36" Command="{Binding SynchronizeCommand}" />
                </StackPanel>
            </Grid>
            <Grid x:Name="AccountEditorPanel" Grid.Column="1" RowDefinitions="26,36,36,36,36" RowSpacing="8" VerticalAlignment="Top">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Text="账号" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip.Tip="{Binding Status}" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,28,28" ColumnSpacing="4">
                    <arc:Select x:Name="SavedAccountPicker" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                              TextSelector="{x:Static converters:MusicSelectLabels.Account}" Size="Small"
                              SelectionChanged="OnSavedAccountSelectionChanged" Placeholder="选择账号" Height="36" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
                    <arc:Button Grid.Column="1" Classes="iconSmall" Variant="Ghost" IsPressScaleEnabled="False" Content="+" FontSize="18" MinHeight="0" Command="{Binding NewAccountCommand}" ToolTip.Tip="新增账号" AutomationProperties.Name="新增账号" VerticalAlignment="Center" />
                    <arc:Button Grid.Column="2" Classes="iconSmall" Variant="Ghost" IsPressScaleEnabled="False" Content="−" FontSize="18" MinHeight="0" Command="{Binding RemoveAccountCommand}" ToolTip.Tip="移除账号" AutomationProperties.Name="移除账号" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <arc:Input x:Name="UsernameEditor" Text="{Binding Username, Mode=TwoWay}" Placeholder="账号" Size="Small" Height="36" IsEnabled="{Binding CanEditAccount}" />
                    <arc:Input x:Name="PasswordEditor" Grid.Column="1" Text="{Binding Password, Mode=TwoWay}" Placeholder="密码" PasswordChar="●" Size="Small" Height="36" IsEnabled="{Binding CanEditAccount}" />
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="6">
                    <arc:Checkbox x:Name="RememberPasswordToggle" Content="记住密码" FontSize="12" IsChecked="{Binding RememberPassword, Mode=TwoWay}" IsEnabled="{Binding CanEditAccount}" MinHeight="36" />
                    <arc:Checkbox x:Name="AutoLoginToggle" Grid.Column="1" Content="自动登录" FontSize="12" IsChecked="{Binding AutoLogin, Mode=TwoWay}" IsEnabled="{Binding CanEditAccount}" MinHeight="36" />
                </Grid>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6">
                    <arc:Button Content="登录" Classes="primary" Size="Small" Height="36" Command="{Binding LoginCommand}" />
                    <arc:Button Content="保存账号" Variant="Secondary" Size="Small" Height="36" Command="{Binding SaveAccountCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
