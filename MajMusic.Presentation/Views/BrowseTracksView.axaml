<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:views="using:MajMusic.Presentation.Views"
             xmlns:theme="using:MajMusic.Presentation.Theme"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="MajMusic.Presentation.Views.BrowseTracksView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.browseList ListBoxItem">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Keep the lane measured even when there is no scrollable data; only its ink disappears. -->
        <Style Selector="ListBox.browseList /template/ ScrollViewer /template/ ScrollBar:vertical[Maximum=0]">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="ScrollViewer#BrowseSkeletonScroll /template/ ScrollBar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="arc|Button.recommendationPage">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Variant" Value="Ghost" />
        </Style>
        <Style Selector="arc|Button.recommendationPage.selected">
            <Setter Property="Background" Value="{DynamicResource MusicSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MusicAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SongCardRow" x:DataType="vm:SongCardRow">
            <views:SongCardRowView Columns="{Binding Columns}" IsBrowsingActive="{Binding $parent[ListBox].IsVisible}"
                                   CardLayout="{Binding CardLayout, RelativeSource={RelativeSource AncestorType=views:BrowseTracksView}}" />
        </DataTemplate>
        <DataTemplate DataType="views:RecommendationFooterRow" x:DataType="views:RecommendationFooterRow">
            <Border DataContext="{Binding Owner}" Margin="6,12,6,8" Padding="10,8" CornerRadius="12"
                    Background="{DynamicResource MusicPanelBrush}" BorderBrush="{DynamicResource MusicLineBrush}" BorderThickness="{x:Static theme:MusicGeometry.OutlineThickness}">
                <Grid x:Name="RecommendationPagination" x:DataType="vm:MainViewModel" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding RecommendationPageNumber}" /><Run Text=" / " /><Run Text="{Binding RecommendationPageCount}" />
                        <Run Text=" · " /><Run Text="{Binding RecommendationTotalCount}" /><Run Text=" 首" />
                    </TextBlock>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding RecommendationPages}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecommendationPageItem">
                                <arc:Button Classes="recommendationPage" Classes.selected="{Binding IsSelected}" Content="{Binding Number}"
                                            Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Number, StringFormat='第 {0} 页'}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>
    <theme:MusicSurfaceHost x:Name="BrowseSurfaceTransition" ChangeVersion="{Binding BrowseTransitionVersion}"
                            SlideDirection="{Binding BrowseTransitionDirection}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="BrowseSurface" SizeChanged="OnBrowseSizeChanged" ClipToBounds="True" Background="{arc:ArcDesignTokenResource Surface}">
            <Grid x:Name="BrowseContentPresentation" IsVisible="{Binding !IsBrowsePlaceholderVisible}"
                              IsHitTestVisible="{Binding !IsBrowsePlaceholderVisible}" IsEnabled="{Binding !IsBrowsePlaceholderVisible}">
                <Grid>
                    <views:BrowseCardListBox x:Name="CardRowsList" Classes="browseList" ItemsSource="{Binding PresentationRows, RelativeSource={RelativeSource AncestorType=views:BrowseTracksView}}" Focusable="True" AutoScrollToSelectedItem="False"
                             CardLayout="{Binding CardLayout, RelativeSource={RelativeSource AncestorType=views:BrowseTracksView}}"
                             Padding="0" BorderThickness="0"
                             IsVisible="{Binding !IsBrowsePlaceholderVisible}"
                             ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </views:BrowseCardListBox>
                </Grid>
            </Grid>
            <Grid x:Name="BrowseSkeletonPresentation" IsVisible="{Binding IsBrowsePlaceholderVisible}" IsHitTestVisible="False" ClipToBounds="True">
                <ScrollViewer x:Name="BrowseSkeletonScroll" Padding="0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                    <views:BrowseSkeletonView x:Name="BrowseSkeletonSurface" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </theme:MusicSurfaceHost>
</UserControl>
