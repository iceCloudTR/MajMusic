<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:views="using:MajMusic.Presentation.Views"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:theme="using:MajMusic.Presentation.Theme"
             x:Class="MajMusic.Presentation.Views.BrowseTracksView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.browseList ListBoxItem">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    <theme:MusicSurfaceHost x:Name="BrowseSurfaceTransition" ChangeVersion="{Binding BrowseTransitionVersion}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="BrowseSurface" SizeChanged="OnBrowseSizeChanged" ClipToBounds="True">
            <arc:PresenceHost x:Name="BrowseContentPresentation" IsPresent="{Binding !IsBrowseLoading}" Mode="Fade"
                              IsHitTestVisible="{Binding !IsBrowseLoading}" IsEnabled="{Binding !IsBrowseLoading}">
                <Grid>
                    <ListBox x:Name="CardRowsList" Classes="browseList" ItemsSource="{Binding BrowseRows}" Focusable="True" AutoScrollToSelectedItem="False"
                             IsVisible="{Binding !IsBrowseLoading}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SongCardRow">
                                <ItemsControl ItemsSource="{Binding Tracks}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding Columns}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SongCardViewModel">
                                            <views:SongCard Margin="6" IsBrowsingActive="{Binding $parent[ListBox].IsVisible}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </arc:PresenceHost>
            <arc:PresenceHost x:Name="BrowseSkeletonPresentation" IsPresent="{Binding IsBrowseLoading}" Mode="Fade" IsHitTestVisible="False"
                              Exited="OnSkeletonHidden">
                <views:BrowseSkeletonView x:Name="BrowseSkeletonSurface" VerticalAlignment="Top" />
            </arc:PresenceHost>
        </Grid>
    </theme:MusicSurfaceHost>
</UserControl>
