<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:views="using:MajMusic.Presentation.Views"
             xmlns:theme="using:MajMusic.Presentation.Theme"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="MajMusic.Presentation.Views.BrowseTracksView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.browseList ListBoxItem">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.browseList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="arc|Button.recommendationPage">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Variant" Value="Ghost" />
        </Style>
        <Style Selector="arc|Button.recommendationPage.selected">
            <Setter Property="Background" Value="{DynamicResource MusicSelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MusicAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SongCardRow" x:DataType="vm:SongCardRow">
            <ItemsControl ItemsSource="{Binding Tracks}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SongCardViewModel">
                        <views:SongCard Margin="6" IsBrowsingActive="{Binding $parent[ListBox].IsVisible}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate DataType="views:RecommendationFooterRow" x:DataType="views:RecommendationFooterRow">
            <Border DataContext="{Binding Owner}" Margin="6,12,6,8" Padding="10,8" CornerRadius="12"
                    Background="{DynamicResource MusicPanelBrush}" BorderBrush="{DynamicResource MusicLineBrush}" BorderThickness="1">
                <Grid x:Name="RecommendationPagination" x:DataType="vm:MainViewModel" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center">
                        <Run Text="{Binding RecommendationPageNumber}" /><Run Text=" / " /><Run Text="{Binding RecommendationPageCount}" />
                        <Run Text=" · " /><Run Text="{Binding RecommendationTotalCount}" /><Run Text=" 首" />
                    </TextBlock>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding RecommendationPages}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecommendationPageItem">
                                <arc:Button Classes="recommendationPage" Classes.selected="{Binding IsSelected}" Content="{Binding Number}"
                                            Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Number, StringFormat='第 {0} 页'}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>
    <theme:MusicSurfaceHost x:Name="BrowseSurfaceTransition" ChangeVersion="{Binding BrowseTransitionVersion}"
                            SlideDirection="{Binding BrowseTransitionDirection}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="BrowseSurface" SizeChanged="OnBrowseSizeChanged" ClipToBounds="True">
            <Grid x:Name="BrowseContentPresentation" IsVisible="{Binding !IsBrowseLoading}"
                              IsHitTestVisible="{Binding !IsBrowseLoading}" IsEnabled="{Binding !IsBrowseLoading}">
                <Grid>
                    <ListBox x:Name="CardRowsList" Classes="browseList" ItemsSource="{Binding PresentationRows, RelativeSource={RelativeSource AncestorType=views:BrowseTracksView}}" Focusable="True" AutoScrollToSelectedItem="False"
                             IsVisible="{Binding !IsBrowseLoading}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </Grid>
            <Grid x:Name="BrowseSkeletonPresentation" IsVisible="{Binding IsBrowseLoading}" IsHitTestVisible="False">
                <views:BrowseSkeletonView x:Name="BrowseSkeletonSurface" VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </theme:MusicSurfaceHost>
</UserControl>
