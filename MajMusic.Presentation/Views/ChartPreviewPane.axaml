<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="MajMusic.Presentation.Views.ChartPreviewPane"
             x:DataType="vm:MainViewModel">
    <Grid ClipToBounds="True">
        <StackPanel x:Name="PreviewSetup" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="8">
            <TextBlock Text="{Binding MajViewStatus}" Classes="detailMuted" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="300" />
            <arc:Button Content="重试" IsVisible="{Binding CanRetryMajView}" Click="OnRetryMajView"
                        MinHeight="36" HorizontalAlignment="Center" />
        </StackPanel>
        <ContentControl x:Name="PreviewSurface" IsVisible="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" />
    </Grid>
</UserControl>
