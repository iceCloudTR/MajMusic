<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:converters="using:MajMusic.Presentation.Converters"
             xmlns:ac="using:Avalonia.Data.Converters"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:theme="using:MajMusic.Presentation.Theme"
             x:Class="MajMusic.Presentation.Views.SongCard"
             x:Name="CardRoot"
             x:DataType="vm:SongCardViewModel">
    <UserControl.Resources>
        <converters:MusicDisplayConverter x:Key="CardDisplay" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="arc|Button.songTile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="{x:Static theme:MusicGeometry.OutlineThickness}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="{DynamicResource MusicPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MusicLineBrush}" />
        </Style>
        <Style Selector="arc|Button.songTile /template/ Border#PART_Frame">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="arc|Button.songTile /template/ arc|SpringSizeDecorator#PART_LabelSlot">
            <Setter Property="CrossClipOverflow" Value="{Binding $parent[UserControl].Bounds.Height}" />
        </Style>
        <Style Selector="arc|Button.songTile:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource MusicMutedBrush}" />
        </Style>
        <Style Selector="arc|Button.songTile.selected">
            <Setter Property="Background" Value="{DynamicResource MusicPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MusicAccentBrush}" />
        </Style>
        <Style Selector="arc|Button.songTile TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MusicTextBrush}" />
        </Style>
        <Style Selector="arc|Button.songTile TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource MusicMutedBrush}" />
        </Style>
        <Style Selector="Grid.cardMetadata">
            <Setter Property="Margin" Value="6" />
            <Setter Property="RowSpacing" Value="2" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="MaxLines" Value="2" />
        </Style>
        <Style Selector="TextBlock.cardSource, TextBlock.cardDuration, TextBlock.cardDownloadStatus">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="TextBlock.cardArtist">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="UserControl.compact TextBlock.cardTitle">
            <Setter Property="MaxHeight" Value="16" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style Selector="UserControl.compact.tight TextBlock.cardArtist, UserControl.compact.tight Grid.cardAudio">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UserControl.small Grid.cardMetadata">
            <Setter Property="Margin" Value="4" />
            <Setter Property="RowSpacing" Value="1" />
        </Style>
        <Style Selector="UserControl.small TextBlock.cardTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="MaxHeight" Value="28" />
        </Style>
        <Style Selector="UserControl.small.tight TextBlock.cardTitle">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="13" />
            <Setter Property="MaxHeight" Value="13" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style Selector="UserControl.small TextBlock.cardArtist">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="LineHeight" Value="11" />
            <Setter Property="MaxHeight" Value="11" />
        </Style>
        <Style Selector="UserControl.small.tiny TextBlock.cardArtist, UserControl.small Grid.cardAudio">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="UserControl.small TextBlock.cardSource, UserControl.small TextBlock.cardDuration, UserControl.small TextBlock.cardDownloadStatus">
            <Setter Property="FontSize" Value="9" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <arc:Button x:Name="SongTile" Variant="Ghost" IsPressScaleEnabled="False" Classes="songTile" Classes.selected="{Binding IsSelected}" Click="OnSelectClicked"
                DoubleTapped="OnPlayDoubleTapped" ToolTip.Tip="{Binding Track.Title}" AutomationProperties.Name="{Binding Track.Title}">
            <Border Width="{Binding CardContentWidth, ElementName=CardRoot}" CornerRadius="10.75" ClipToBounds="True">
                <Grid ClipToBounds="True">
                    <Grid x:Name="CardArtGrid" ColumnDefinitions="*,*">
                        <Border Background="{DynamicResource MusicRaisedBrush}" ClipToBounds="True">
                            <Grid>
                                <Path Data="M 7,6 L 7,17 C 7,21 2,21 2,18 C 2,16 4,15 6,16 L 6,7 L 15,5 L 15,14 C 15,18 10,18 10,15 C 10,13 12,12 14,13 L 14,8 Z"
                                      Fill="{DynamicResource MusicMutedBrush}" Width="28" Height="30" Stretch="Uniform"
                                      IsVisible="{Binding Cover, Converter={x:Static ac:ObjectConverters.IsNull}}" />
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <Grid x:Name="CardInformationPane" Grid.Column="1" Background="{DynamicResource MusicPanelBrush}">
                            <Border IsHitTestVisible="False" Background="{DynamicResource MusicAccentBrush}" Opacity="{Binding InformationOpacity, ElementName=CardFeedback}" />
                            <Grid IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding DownloadEmptyHeight}" />
                                    <RowDefinition Height="{Binding DownloadFillHeight}" />
                                </Grid.RowDefinitions>
                                <Border x:Name="CardDownloadFill" Grid.Row="1" Background="{DynamicResource MusicDownloadBrush}" />
                            </Grid>
                            <Grid Classes="cardMetadata" RowDefinitions="Auto,Auto,*,Auto,Auto">
                                <TextBlock Classes="cardTitle" Text="{Binding Track.Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Text="{Binding Track.Artist}" Classes="secondary cardArtist" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Track.Artist}" />
                                <Grid Grid.Row="2" ColumnDefinitions="14,*" ColumnSpacing="4" IsVisible="{Binding HasDownloadStatus}" VerticalAlignment="Bottom" MinHeight="14">
                                    <theme:DownloadCompletionCue x:Name="CardCompletionCue" Width="14" Height="14" IsCompleted="{Binding IsDownloaded}"
                                                                 IsDownloading="{Binding IsDownloading}" Accent="{DynamicResource MusicAccentBrush}" />
                                    <TextBlock x:Name="CardDownloadStatus" Classes="cardDownloadStatus" Grid.Column="1" Text="{Binding DownloadStatus}" MinHeight="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Grid.Row="3" Classes="cardAudio">
                                    <TextBlock Text="{Binding Track, Converter={StaticResource CardDisplay}, ConverterParameter=audio}" IsVisible="{Binding !IsDownloading}" FontSize="10" Classes="secondary" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CardDownloadDetails" Text="{Binding DownloadDetails}" IsVisible="{Binding IsDownloading}" FontSize="10" Classes="secondary" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DownloadDetails}" />
                                </Grid>
                                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding Track, Converter={StaticResource CardDisplay}, ConverterParameter=source}" Classes="secondary cardSource" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Track, Converter={StaticResource CardDisplay}, ConverterParameter=duration}" Classes="secondary cardDuration" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </arc:Button>
        <theme:CardFeedbackBorder x:Name="CardFeedback" IsHovered="{Binding IsPointerOver, ElementName=SongTile}" IsSelected="{Binding IsSelected}"
                                  HasDownloadStatus="{Binding HasDownloadStatus}" Accent="{DynamicResource MusicAccentBrush}" />
    </Grid>
</UserControl>
