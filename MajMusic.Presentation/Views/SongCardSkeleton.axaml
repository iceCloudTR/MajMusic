<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:theme="using:MajMusic.Presentation.Theme"
             xmlns:views="using:MajMusic.Presentation.Views"
             x:Class="MajMusic.Presentation.Views.SongCardSkeleton"
             IsHitTestVisible="False" Focusable="False">
    <UserControl.Styles>
        <Style Selector="Grid.skeletonInformation">
            <Setter Property="Margin" Value="12" />
        </Style>
        <Style Selector="views|SongCardSkeleton.small Grid.skeletonInformation">
            <Setter Property="Margin" Value="4" />
        </Style>
    </UserControl.Styles>
    <Border CornerRadius="12" ClipToBounds="True" BorderThickness="{x:Static theme:MusicGeometry.OutlineThickness}"
            BorderBrush="{DynamicResource MusicLineBrush}" Background="{DynamicResource MusicPanelBrush}">
        <Grid x:Name="SkeletonArtworkGrid" ColumnDefinitions="*,*">
            <Border x:Name="SkeletonCover" Background="{arc:SkeletonTokenResource BlockColor}" />
            <Grid Classes="skeletonInformation" Grid.Column="1" RowDefinitions="Auto,*,Auto">
                <arc:Skeleton x:Name="SkeletonTitle" Lines="2" Label="正在加载音乐" />
                <arc:Skeleton Grid.Row="2" Lines="1" Label="正在加载音频信息" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
