<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:models="using:MajMusic.Core.Models"
             xmlns:converters="using:MajMusic.Presentation.Converters"
             xmlns:ac="using:Avalonia.Data.Converters"
             xmlns:views="using:MajMusic.Presentation.Views"
             x:Class="MajMusic.Presentation.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource MusicCanvasBrush}">
    <UserControl.Styles>
        <StyleInclude Source="avares://MajMusic.Presentation/Styles/MusicStyles.axaml" />
    </UserControl.Styles>
    <UserControl.Resources>
        <converters:MusicDisplayConverter x:Key="MusicDisplay" />
        <StreamGeometry x:Key="ShuffleGlyph">M 2,5 L 5,5 C 7,5 9,11 11,11 L 14,11 M 11,8 L 14,11 L 11,14 M 2,11 L 5,11 C 7,11 9,5 11,5 L 14,5 M 11,2 L 14,5 L 11,8</StreamGeometry>
        <StreamGeometry x:Key="RepeatGlyph">M 2,7 C 2,5.895 2.895,5 4,5 L 14,5 M 11,2 L 14,5 L 11,8 M 14,9 C 14,10.105 13.105,11 12,11 L 2,11 M 5,8 L 2,11 L 5,14</StreamGeometry>
    </UserControl.Resources>
    <UserControl.DataTemplates>
        <DataTemplate DataType="models:MusicPlaylist" x:DataType="models:MusicPlaylist">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding ., Converter={StaticResource MusicDisplay}}" FontSize="11" Classes="muted" MaxWidth="100" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ., Converter={StaticResource MusicDisplay}}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:EndpointProfile" x:DataType="vm:EndpointProfile">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate DataType="vm:SavedAccountOption" x:DataType="vm:SavedAccountOption">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate DataType="vm:DirectoryKindOption" x:DataType="vm:DirectoryKindOption">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
        <DataTemplate DataType="models:AudioOutputDevice" x:DataType="models:AudioOutputDevice">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate DataType="models:LocalDirectorySource" x:DataType="models:LocalDirectorySource">
            <Grid Margin="10,6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ., Converter={StaticResource MusicDisplay}}" Classes="muted" FontSize="11" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid RowDefinitions="Auto,*,16,113" Margin="22,18" RowSpacing="8">
        <Grid Height="30" ColumnDefinitions="Auto,*" ColumnSpacing="9">
            <Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource MusicAccentBrush}" VerticalAlignment="Center">
                <Path Data="M 7,6 L 7,17 C 7,21 2,21 2,18 C 2,16 4,15 6,16 L 6,7 L 15,5 L 15,14 C 15,18 10,18 10,15 C 10,13 12,12 14,13 L 14,8 Z" Fill="{DynamicResource MusicAccentTextBrush}" Stretch="Uniform" Width="15" Height="16" />
            </Border>
            <TextBlock Grid.Column="1" Text="MajMusic" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <TabControl x:Name="MainTabs" Grid.Row="1" Padding="0">
            <TabItem x:Name="LibraryTab" Header="主页">
                <Grid x:Name="LibraryLayout" RowDefinitions="34,*,28" RowSpacing="8" ColumnSpacing="12" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.24*" MinWidth="180" MaxWidth="220" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2" ColumnDefinitions="196,*,34" ColumnSpacing="8">
                        <Border CornerRadius="8" Background="{DynamicResource MusicRaisedBrush}" Padding="2">
                            <Grid x:Name="HomeModeSegments" ColumnDefinitions="*,*,*">
                                <ToggleButton x:Name="RecommendationsModeButton" Classes="mode" Content="推荐" IsChecked="{Binding IsRecommendationsMode, Mode=OneWay}" Command="{Binding ShowRecommendationsModeCommand}" />
                                <ToggleButton x:Name="PlaylistsModeButton" Grid.Column="1" Classes="mode" Content="歌单" IsChecked="{Binding IsPlaylistsMode, Mode=OneWay}" Command="{Binding ShowPlaylistsModeCommand}" />
                                <ToggleButton x:Name="LibraryModeButton" Grid.Column="2" Classes="mode" Content="曲库" IsChecked="{Binding IsLibraryMode, Mode=OneWay}" Command="{Binding ShowLibraryModeCommand}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid IsVisible="{Binding !IsSearchExpanded}">
                                <ComboBox x:Name="HomeEndpointPicker" ItemsSource="{Binding EndpointProfiles}" SelectedItem="{Binding SelectedEndpointProfile}" PlaceholderText="接入点" HorizontalAlignment="Stretch" IsVisible="{Binding IsRecommendationsMode}" IsEnabled="{Binding IsIdle}" />
                                <ComboBox x:Name="HomePlaylistPicker" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedHomePlaylist}" PlaceholderText="选择歌单" HorizontalAlignment="Stretch" IsVisible="{Binding IsPlaylistsMode}" />
                            </Grid>
                            <TextBox x:Name="LibrarySearch" Text="{Binding SearchText}" PlaceholderText="搜索音乐" KeyDown="OnSearchKeyDown" IsVisible="{Binding IsSearchExpanded}" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Button x:Name="BeginSearchButton" Classes="icon" Command="{Binding BeginSearchCommand}" Click="OnBeginSearchClicked" IsVisible="{Binding !IsSearchExpanded}" ToolTip.Tip="搜索音乐" AutomationProperties.Name="搜索音乐">
                                <Path Data="M 8,2 A 6,6 0 1 0 8,14 A 6,6 0 1 0 8,2 M 12.5,12.5 L 18,18" Stroke="{DynamicResource MusicTextBrush}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="CancelSearchButton" Classes="icon" Content="×" FontSize="21" Command="{Binding CancelSearchCommand}" IsVisible="{Binding IsSearchExpanded}" ToolTip.Tip="返回推荐" AutomationProperties.Name="返回推荐" />
                        </Grid>
                    </Grid>
                    <Border x:Name="LibraryListPanel" Grid.Row="1" Classes="card" Padding="6">
                        <views:BrowseTracksView x:Name="SongBrowser" />
                    </Border>
                    <Border x:Name="LibraryDetails" Grid.Row="1" Grid.Column="1" Classes="card" Padding="10">
                        <Grid RowSpacing="6" IsVisible="{Binding SelectedBrowseTrack, Converter={x:Static ac:ObjectConverters.IsNotNull}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MaxHeight="120" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <Viewbox Stretch="Uniform" MaxWidth="120" MaxHeight="120" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Border Width="120" Height="120" CornerRadius="12" Background="{DynamicResource MusicRaisedBrush}" ClipToBounds="True">
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                </Border>
                            </Viewbox>
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock Text="{Binding SelectedTrack.Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedTrack.Artist}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button Content="{Binding FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}" FontSize="12" Padding="5,4" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="下载" Command="{Binding DownloadCommand}" FontSize="12" Padding="5,4" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid Grid.Row="3" ColumnDefinitions="*,32" ColumnSpacing="6">
                                <ComboBox ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" PlaceholderText="歌单" HorizontalAlignment="Stretch" MinHeight="32" FontSize="12" Padding="6,4" />
                                <Button Grid.Column="1" Classes="icon" Content="+" FontSize="19" Command="{Binding AddToPlaylistCommand}" ToolTip.Tip="加入歌单" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding BrowseSummary}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="更多推荐" Command="{Binding MoreRecommendationsCommand}" IsVisible="{Binding HasMoreRecommendations}" Padding="10,2" MinHeight="28" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="歌单管理">
                <Grid Margin="0,8,0,0" RowDefinitions="34,*,34" RowSpacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,32" ColumnSpacing="6">
                        <Button Content="打开" Classes="primary" Command="{Binding OpenPlaylistCommand}" Click="OnOpenPlaylistClicked" />
                        <Button Grid.Column="1" Content="导入" Click="OnCollectionImportClicked" IsEnabled="{Binding IsIdle}" IsVisible="{Binding CanExchangeCollections}" />
                        <Button Grid.Column="2" Content="导出" Click="OnCollectionExportClicked" IsEnabled="{Binding IsIdle}" IsVisible="{Binding CanExchangeCollections}" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding EndpointProfiles}" SelectedItem="{Binding SelectedEndpointProfile}" PlaceholderText="接入点" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="4" Classes="icon" Content="↻" FontSize="18" Command="{Binding RefreshCloudPlaylistsCommand}" ToolTip.Tip="刷新云端歌单" />
                    </Grid>
                    <Border Grid.Row="1" Classes="card" Padding="6">
                        <ListBox x:Name="PlaylistList" ItemsSource="{Binding VisiblePlaylists}" SelectedItem="{Binding SelectedPlaylist}" SizeChanged="OnPlaylistViewportSizeChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,32,32" ColumnSpacing="6">
                        <TextBox Text="{Binding NewPlaylistName}" PlaceholderText="新歌单名称" />
                        <Button Grid.Column="1" Content="创建" Command="{Binding CreatePlaylistCommand}" />
                        <TextBlock Grid.Column="2" Text="{Binding PlaylistPageText}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                        <Button Grid.Column="3" Classes="icon" Content="‹" FontSize="20" Command="{Binding PreviousPlaylistPageCommand}" ToolTip.Tip="上一页" />
                        <Button Grid.Column="4" Classes="icon" Content="›" FontSize="20" Command="{Binding NextPlaylistPageCommand}" ToolTip.Tip="下一页" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="DirectoriesTab" Header="目录">
                <Grid Margin="0,8,0,0" RowDefinitions="32,*,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,32,32" ColumnSpacing="6">
                        <TextBlock Text="本地目录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="新增" Command="{Binding NewDirectoryCommand}" />
                        <Button Grid.Column="2" Content="读取全部" Command="{Binding RescanCommand}" />
                        <TextBlock Grid.Column="3" Text="{Binding DirectoryPageText}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                        <Button Grid.Column="4" Classes="icon" Content="‹" FontSize="20" Command="{Binding PreviousDirectoryPageCommand}" ToolTip.Tip="上一页" />
                        <Button Grid.Column="5" Classes="icon" Content="›" FontSize="20" Command="{Binding NextDirectoryPageCommand}" ToolTip.Tip="下一页" />
                    </Grid>
                    <Border Grid.Row="1" Classes="card" Padding="6">
                        <ListBox x:Name="DirectoryList" ItemsSource="{Binding VisibleDirectorySources}" SelectedItem="{Binding SelectedDirectory}" IsEnabled="{Binding IsIdle}" SizeChanged="OnDirectoryViewportSizeChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <Border Grid.Row="2" Classes="card" Padding="10">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="130,*,32" ColumnSpacing="6">
                                <ComboBox x:Name="DirectoryKindPicker" ItemsSource="{Binding DirectoryKinds}" SelectedItem="{Binding SelectedDirectoryKind}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
                                <TextBox Grid.Column="1" Text="{Binding DirectoryPath}" PlaceholderText="目录路径" IsEnabled="{Binding IsIdle}" />
                                <Button Grid.Column="2" Classes="icon" Content="…" Click="OnDirectoryBrowseClicked" IsEnabled="{Binding IsIdle}" ToolTip.Tip="选择目录" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="保存并读取" Classes="primary" Command="{Binding SaveDirectoryCommand}" />
                                <Button Content="重新读取" Command="{Binding ScanDirectoryCommand}" />
                                <Button Content="移除" Classes="quiet" Command="{Binding RemoveDirectoryCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="AccountsTab" Header="账号">
                <Grid Margin="0,8,0,0" RowDefinitions="34,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,32,32,Auto" ColumnSpacing="6">
                        <ComboBox x:Name="EndpointPicker" ItemsSource="{Binding EndpointProfiles}" SelectedItem="{Binding SelectedEndpointProfile}" PlaceholderText="接入点" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
                        <Button Grid.Column="1" Classes="icon" Content="+" FontSize="19" Command="{Binding NewEndpointCommand}" ToolTip.Tip="新增接入点" />
                        <Button Grid.Column="2" Classes="icon" Content="−" FontSize="19" Command="{Binding RemoveEndpointCommand}" ToolTip.Tip="移除接入点" />
                        <CheckBox x:Name="OnlineModeToggle" Grid.Column="3" Content="在线" IsChecked="{Binding OnlineEnabled}" Margin="10,0,0,0" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" Height="198" VerticalAlignment="Top">
                        <Border x:Name="EndpointEditorPanel" Classes="card" Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="接入点" FontWeight="SemiBold" />
                                <TextBox Text="{Binding EndpointName}" PlaceholderText="名称" IsEnabled="{Binding IsIdle}" />
                                <TextBox Text="{Binding EndpointUrl}" PlaceholderText="API 地址" IsEnabled="{Binding IsIdle}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="保存" Command="{Binding SaveSettingsCommand}" />
                                    <Button Content="同步" Command="{Binding SynchronizeCommand}" />
                                    <Button Content="同步全部" Classes="quiet" Command="{Binding SynchronizeAllCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AccountEditorPanel" Grid.Column="1" Classes="card" Padding="10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="登录账号" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedAccountLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid ColumnDefinitions="*,28,28" ColumnSpacing="4">
                                    <ComboBox x:Name="SavedAccountPicker" ItemsSource="{Binding SavedAccounts}" SelectedItem="{Binding SelectedSavedAccount}" SelectionChanged="OnSavedAccountSelectionChanged" PlaceholderText="选择账号" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
                                    <Button Grid.Column="1" Classes="iconSmall" Content="+" FontSize="18" Command="{Binding NewAccountCommand}" ToolTip.Tip="新增账号" />
                                    <Button Grid.Column="2" Classes="iconSmall" Content="−" FontSize="18" Command="{Binding RemoveAccountCommand}" ToolTip.Tip="移除账号" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <TextBox Text="{Binding LoginUsername}" PlaceholderText="账号" IsEnabled="{Binding IsIdle}" />
                                    <TextBox Grid.Column="1" Text="{Binding LoginPassword}" PlaceholderText="密码" PasswordChar="●" IsEnabled="{Binding IsIdle}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" Height="32">
                                    <CheckBox x:Name="RememberPasswordToggle" Content="记住密码" FontSize="12" IsChecked="{Binding RememberPassword}" IsEnabled="{Binding IsIdle}" MinHeight="32" />
                                    <CheckBox x:Name="AutoLoginToggle" Grid.Column="1" Content="自动登录" FontSize="12" IsChecked="{Binding AutoLogin}" IsEnabled="{Binding IsIdle}" MinHeight="32" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="登录" Classes="primary" Command="{Binding LoginCommand}" />
                                    <Button Content="保存账号" Command="{Binding SaveAccountCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="SettingsTab" Header="设置">
                <StackPanel Margin="0,8,0,0" Spacing="10">
                    <Border x:Name="AudioSettingsPanel" Classes="card" Padding="10">
                        <Grid RowDefinitions="34,34,16" RowSpacing="8" ColumnDefinitions="80,*,38,Auto" ColumnSpacing="10">
                            <TextBlock Text="输出设备" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="*,32" ColumnSpacing="6">
                                <ComboBox x:Name="OutputDevicePicker" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanConfigureAudio}" />
                                <Button Grid.Column="1" Classes="icon" Content="↻" FontSize="18" Command="{Binding RefreshOutputDevicesCommand}" ToolTip.Tip="刷新设备" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="音量" Classes="fieldLabel" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Volume}" Minimum="0" Maximum="100" IsEnabled="{Binding CanConfigureAudio}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <CheckBox Grid.Row="1" Grid.Column="3" Content="静音" IsChecked="{Binding IsMuted}" IsEnabled="{Binding CanConfigureAudio}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding AudioOutputNotice}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AudioOutputNotice}" />
                        </Grid>
                    </Border>
                    <Border x:Name="CacheSettingsPanel" Classes="card" Padding="10">
                        <Grid RowDefinitions="Auto,32" RowSpacing="8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="缓存" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="{Binding DataDirectory}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DataDirectory}" />
                            <Button Grid.Row="1" Grid.Column="1" Content="清理缓存" Command="{Binding ClearCacheCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" Height="16">
            <TextBlock Text="{Binding PlaybackHint}" IsVisible="{Binding HasPlaybackHint}" Classes="muted" FontSize="11" MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PlaybackHint}" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" IsVisible="{Binding HasStatus}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
        </Grid>
        <Border x:Name="PlaybackBar" Grid.Row="3" Background="{DynamicResource MusicPanelBrush}" BorderBrush="{DynamicResource MusicLineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
            <Grid RowDefinitions="40,48" RowSpacing="3">
                <Grid>
                    <Grid ColumnDefinitions="*,224,*">
                        <StackPanel x:Name="PlaybackMetadata" Spacing="3" VerticalAlignment="Center" ToolTip.Tip="{Binding AudioDetails}">
                            <TextBlock Text="{Binding PlaybackTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PlaybackArtist}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Grid x:Name="PlaybackVolume" Grid.Column="2" ColumnDefinitions="*,Auto,100" ColumnSpacing="8" VerticalAlignment="Center">
                            <CheckBox Grid.Column="1" Content="静音" IsChecked="{Binding IsMuted}" IsEnabled="{Binding CanConfigureAudio}" FontSize="11" />
                            <Slider Grid.Column="2" Value="{Binding Volume}" Minimum="0" Maximum="100" IsEnabled="{Binding CanConfigureAudio}" ToolTip.Tip="{Binding VolumeText}" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="TransportGroup" Width="200" Height="40" ColumnDefinitions="40,40,40,40,40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="ShuffleButton" Classes="transport modeTransport" Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="{Binding ShuffleModeText}" AutomationProperties.Name="{Binding ShuffleModeText}">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="TransportShuffleIcon" Classes="modeGlyph" Classes.active="{Binding IsShuffle}" Data="{StaticResource ShuffleGlyph}" />
                            </Canvas>
                        </Button>
                        <Button x:Name="PreviousTrackButton" Grid.Column="1" Classes="transport" Command="{Binding PreviousCommand}" ToolTip.Tip="上一首" AutomationProperties.Name="上一首">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="TransportPreviousIcon" Data="M 3,2 L 5,2 L 5,14 L 3,14 Z M 13,2 L 5,8 L 13,14 Z" Fill="{DynamicResource MusicTextBrush}" Width="16" Height="16" Stretch="None" />
                            </Canvas>
                        </Button>
                        <Button x:Name="TransportButton" Grid.Column="2" Classes="primary transportPrimary" Command="{Binding TogglePlayPauseCommand}" Width="36" Height="36" MinHeight="0" Padding="0" CornerRadius="18" ToolTip.Tip="{Binding TransportButtonText}" AutomationProperties.Name="{Binding TransportButtonText}">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="TransportPlayIcon" Data="M 5,2 L 13,8 L 5,14 Z" Fill="{DynamicResource MusicAccentTextBrush}" Width="16" Height="16" Stretch="None" IsVisible="{Binding !IsPlaying}" />
                                <Path x:Name="TransportPauseIcon" Data="M 4,2 L 7,2 L 7,14 L 4,14 Z M 9,2 L 12,2 L 12,14 L 9,14 Z" Fill="{DynamicResource MusicAccentTextBrush}" Width="16" Height="16" Stretch="None" IsVisible="{Binding IsPlaying}" />
                            </Canvas>
                        </Button>
                        <Button x:Name="NextTrackButton" Grid.Column="3" Classes="transport" Command="{Binding NextCommand}" ToolTip.Tip="下一首" AutomationProperties.Name="下一首">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="TransportNextIcon" Data="M 11,2 L 13,2 L 13,14 L 11,14 Z M 3,2 L 11,8 L 3,14 Z" Fill="{DynamicResource MusicTextBrush}" Width="16" Height="16" Stretch="None" />
                            </Canvas>
                        </Button>
                        <Button x:Name="RepeatButton" Grid.Column="4" Classes="transport modeTransport" Command="{Binding CycleRepeatModeCommand}" ToolTip.Tip="{Binding RepeatModeText}" AutomationProperties.Name="{Binding RepeatModeText}">
                            <Grid Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Path x:Name="TransportRepeatIcon" Classes="modeGlyph" Classes.active="{Binding IsRepeating}" Data="{StaticResource RepeatGlyph}" />
                                </Canvas>
                                <TextBlock Text="1" IsVisible="{Binding IsRepeatOne}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource MusicAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="42,*,42" ColumnSpacing="10">
                    <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Classes="muted" FontSize="11" />
                    <Slider x:Name="PlaybackTimeline" Grid.Column="1" Height="48" VerticalAlignment="Center" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" IsEnabled="{Binding CanSeek}" SmallChange="5" LargeChange="15" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="muted" FontSize="11" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
