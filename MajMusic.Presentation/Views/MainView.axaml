<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:models="using:MajMusic.Core.Models"
             xmlns:converters="using:MajMusic.Presentation.Converters"
             xmlns:ac="using:Avalonia.Data.Converters"
             xmlns:views="using:MajMusic.Presentation.Views"
             xmlns:theme="using:MajMusic.Presentation.Theme"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="MajMusic.Presentation.Views.MainView"
             x:Name="ViewRoot"
             x:DataType="vm:MainViewModel"
             theme:AppearanceBridge.FollowPreference="True"
             Background="{DynamicResource MusicCanvasBrush}">
    <UserControl.Styles>
        <StyleInclude Source="avares://MajMusic.Presentation/Styles/MusicStyles.axaml" />
        <Style Selector="arc|SearchField.toolbarSearch /template/ arc|PresenceHost#PART_ClearPresence">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="arc|SearchField.toolbarSearch /template/ arc|FieldFrame#PART_Frame">
            <Setter Property="Padding" Value="12,0,20,0" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <converters:MusicDisplayConverter x:Key="MusicDisplay" />
        <StreamGeometry x:Key="ShuffleGlyph">M 2,5 L 5,5 C 7,5 9,11 11,11 L 14,11 M 11,8 L 14,11 L 11,14 M 2,11 L 5,11 C 7,11 9,5 11,5 L 14,5 M 11,2 L 14,5 L 11,8</StreamGeometry>
        <StreamGeometry x:Key="RepeatGlyph">M 2,7 C 2,5.895 2.895,5 4,5 L 14,5 M 11,2 L 14,5 L 11,8 M 14,9 C 14,10.105 13.105,11 12,11 L 2,11 M 5,8 L 2,11 L 5,14</StreamGeometry>
    </UserControl.Resources>
    <UserControl.DataTemplates>
        <DataTemplate DataType="models:MusicPlaylist" x:DataType="models:MusicPlaylist">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding ., Converter={StaticResource MusicDisplay}}" FontSize="11" Classes="muted" MaxWidth="100" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ., Converter={StaticResource MusicDisplay}}" />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="vm:EndpointProfile" x:DataType="vm:EndpointProfile">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate DataType="vm:SavedAccountOption" x:DataType="vm:SavedAccountOption">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate DataType="vm:DirectoryKindOption" x:DataType="vm:DirectoryKindOption">
            <TextBlock Text="{Binding Name}" />
        </DataTemplate>
        <DataTemplate DataType="models:AudioOutputDevice" x:DataType="models:AudioOutputDevice">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <DataTemplate DataType="models:LocalDirectorySource" x:DataType="models:LocalDirectorySource">
            <Grid Margin="10,6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ., Converter={StaticResource MusicDisplay}}" Classes="muted" FontSize="11" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid x:Name="DesktopLayout" RowDefinitions="44,*,16,113" Margin="22,18" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="12" Background="{DynamicResource MusicAccentBrush}">
                    <Path Data="M 7,6 L 7,17 C 7,21 2,21 2,18 C 2,16 4,15 6,16 L 6,7 L 15,5 L 15,14 C 15,18 10,18 10,15 C 10,13 12,12 14,13 L 14,8 Z" Fill="{DynamicResource MusicAccentTextBrush}" Stretch="Uniform" Width="16" Height="17" />
                </Border>
                <TextBlock Text="MajMusic" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <arc:SegmentedControl x:Name="DesktopTopNavigation" Grid.Column="2" Width="410" Height="44" VerticalAlignment="Center"
                                  Loaded="OnDesktopNavigationLoaded" SelectionChanged="OnDesktopNavigationSelectionChanged">
                <arc:SegmentedControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </arc:SegmentedControl.ItemsPanel>
                <arc:SegmentedOption Value="0" Label="主页" />
                <arc:SegmentedOption Value="1" Label="歌单管理" />
                <arc:SegmentedOption Value="2" Label="目录" />
                <arc:SegmentedOption Value="3" Label="账号" />
                <arc:SegmentedOption Value="4" Label="设置" />
            </arc:SegmentedControl>
        </Grid>
        <TabControl x:Name="MainTabs" Classes="desktopPages" Grid.Row="1" Padding="0" SelectionChanged="OnDesktopSectionChanged">
            <TabItem x:Name="LibraryTab" Header="主页">
                <Grid x:Name="LibraryLayout" RowDefinitions="44,*,28" RowSpacing="10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.24*" MinWidth="180" MaxWidth="220" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.ColumnSpan="2" ColumnDefinitions="210,*" ColumnSpacing="10">
                        <arc:SegmentedControl x:Name="HomeModeSegments" SelectedValue="{Binding HomeMode, Mode=OneWay}" SelectionChanged="OnHomeModeSelectionChanged" PointerReleased="OnHomeModePointerReleased" KeyDown="OnHomeModeKeyDown" HorizontalAlignment="Stretch">
                            <arc:SegmentedControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </arc:SegmentedControl.ItemsPanel>
                            <arc:SegmentedOption Value="{x:Static vm:HomeBrowseMode.Recommendations}" Label="推荐" />
                            <arc:SegmentedOption Value="{x:Static vm:HomeBrowseMode.Playlists}" Label="歌单" />
                            <arc:SegmentedOption Value="{x:Static vm:HomeBrowseMode.Library}" Label="曲库" />
                        </arc:SegmentedControl>
                        <theme:SearchRevealPanel x:Name="DesktopSearchReveal" Grid.Column="1" IsExpanded="{Binding IsSearchExpanded}" Height="44" UseLayoutRounding="False">
                            <Grid x:Name="HomeSourceSelectors" ClipToBounds="True">
                                <arc:Select x:Name="HomeEndpointPicker" ItemsSource="{Binding EndpointProfiles}" TextSelector="{x:Static converters:MusicSelectLabels.Endpoint}" SelectedItem="{Binding SelectedEndpointProfile}" Placeholder="接入点" Size="Medium" Height="44" MinHeight="44" HorizontalAlignment="Stretch" IsVisible="{Binding IsRecommendationsMode}" IsEnabled="{Binding IsIdle}" />
                                <arc:Select x:Name="HomePlaylistPicker" ItemsSource="{Binding Playlists}" TextSelector="{x:Static converters:MusicSelectLabels.Playlist}" SelectedItem="{Binding SelectedHomePlaylist}" Placeholder="选择歌单" Size="Medium" Height="44" MinHeight="44" HorizontalAlignment="Stretch" IsVisible="{Binding IsPlaylistsMode}" />
                            </Grid>
                            <Border x:Name="LibrarySearchRevealHost" Height="44" ClipToBounds="True">
                                <arc:SearchField x:Name="LibrarySearch" Classes="toolbarSearch" Text="{Binding SearchText}" Placeholder="搜索音乐" Size="Medium" Height="44" MinHeight="44" />
                            </Border>
                            <arc:Button x:Name="BeginSearchButton" Classes="icon" Width="44" Height="44" CornerRadius="22" IsPressScaleEnabled="False" LabelSwapMode="None" Transitions="{x:Null}" Command="{Binding BeginSearchCommand}" Click="OnBeginSearchClicked" ToolTip.Tip="搜索音乐" AutomationProperties.Name="搜索音乐">
                                <Path Data="M 8,2 A 6,6 0 1 0 8,14 A 6,6 0 1 0 8,2 M 12.5,12.5 L 18,18" Stroke="{DynamicResource MusicTextBrush}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" />
                            </arc:Button>
                            <arc:Button x:Name="CancelSearchButton" Classes="icon" Width="44" Height="44" CornerRadius="22" Background="Transparent" IsPressScaleEnabled="False" LabelSwapMode="None" Transitions="{x:Null}" Click="OnCancelSearchClicked" ToolTip.Tip="关闭搜索" AutomationProperties.Name="关闭搜索">
                                <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{DynamicResource MusicTextBrush}" StrokeThickness="1.8" StrokeLineCap="Round" Width="16" Height="16" Stretch="None" />
                            </arc:Button>
                        </theme:SearchRevealPanel>
                    </Grid>
                    <Border x:Name="LibraryListPanel" Grid.Row="1" Classes="card" Padding="6">
                        <views:BrowseTracksView x:Name="SongBrowser" />
                    </Border>
                    <Border x:Name="LibraryDetails" Grid.Row="1" Grid.Column="1" Classes="card" Padding="10">
                        <Grid RowSpacing="6" VerticalAlignment="Top" IsVisible="{Binding SelectedBrowseTrack, Converter={x:Static ac:ObjectConverters.IsNotNull}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <Viewbox x:Name="DesktopDetailsCover" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <Border Width="240" Height="240" CornerRadius="12" Background="{DynamicResource MusicRaisedBrush}" ClipToBounds="True">
                                    <theme:CoverTransition Source="{Binding Cover}" Stretch="UniformToFill" />
                                </Border>
                            </Viewbox>
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock Text="{Binding SelectedTrack.Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedTrack.Artist}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                                <arc:Button Content="{Binding FavoriteButtonText}" Command="{Binding ToggleFavoriteCommand}" FontSize="12" Padding="5,4" HorizontalAlignment="Stretch" />
                                <arc:Button Grid.Column="1" Content="下载" Command="{Binding DownloadCommand}" FontSize="12" Padding="5,4" HorizontalAlignment="Stretch" />
                                <arc:Button Grid.Column="2" Classes="icon" Content="−" FontSize="18" Command="{Binding RemoveFromPlaylistCommand}" IsVisible="{Binding IsLocalPlaylistView}" ToolTip.Tip="从歌单移除" AutomationProperties.Name="从歌单移除" />
                            </Grid>
                            <Grid Grid.Row="3" ColumnDefinitions="*,32" ColumnSpacing="6">
                                <arc:Select ItemsSource="{Binding Playlists}" TextSelector="{x:Static converters:MusicSelectLabels.Playlist}" SelectedItem="{Binding SelectedPlaylist}" Placeholder="歌单" HorizontalAlignment="Stretch" MinHeight="32" FontSize="12" Padding="6,4" />
                                <arc:Button Grid.Column="1" Classes="icon" Content="+" FontSize="19" Command="{Binding AddToPlaylistCommand}" ToolTip.Tip="加入歌单" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding BrowseSummary}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="歌单管理">
                <Grid Margin="0" RowDefinitions="38,*,42" RowSpacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,32" ColumnSpacing="6">
                        <arc:Button Content="打开" Classes="primary" Command="{Binding OpenPlaylistCommand}" Click="OnOpenPlaylistClicked" />
                        <arc:Button Grid.Column="1" Content="删除" Command="{Binding DeletePlaylistCommand}" />
                        <arc:Button Grid.Column="2" Content="导入" Click="OnCollectionImportClicked" IsEnabled="{Binding IsIdle}" IsVisible="{Binding CanExchangeCollections}" />
                        <arc:Button Grid.Column="3" Content="导出" Click="OnCollectionExportClicked" IsEnabled="{Binding IsIdle}" IsVisible="{Binding CanExchangeCollections}" />
                        <arc:Select Grid.Column="4" ItemsSource="{Binding EndpointProfiles}" TextSelector="{x:Static converters:MusicSelectLabels.Endpoint}" SelectedItem="{Binding SelectedEndpointProfile}" Placeholder="接入点" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
                        <arc:Button Grid.Column="5" Classes="icon" Content="↻" FontSize="18" Command="{Binding RefreshCloudPlaylistsCommand}" ToolTip.Tip="刷新云端歌单" />
                    </Grid>
                    <Border Grid.Row="1" Classes="card" Padding="6">
                        <ListBox x:Name="PlaylistList" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" ContextRequested="OnPlaylistContextRequested" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                        <arc:Input Text="{Binding NewPlaylistName}" Placeholder="新歌单名称" />
                        <arc:Button Grid.Column="1" Content="创建" Command="{Binding CreatePlaylistCommand}" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="DirectoriesTab" Header="目录">
                <Grid Margin="0" RowDefinitions="Auto,38,*,Auto" RowSpacing="8">
                    <Border Classes="card" Padding="10">
                        <Grid ColumnDefinitions="Auto,150,*,32,Auto" ColumnSpacing="6">
                            <TextBlock Text="媒体储存" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <arc:Select x:Name="MediaStorageModePicker" Grid.Column="1" ItemsSource="{Binding MediaStorageModes}"
                                        TextSelector="{x:Static converters:MusicSelectLabels.MediaStorageMode}"
                                        SelectedItem="{Binding SelectedMediaStorageMode, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" />
                            <arc:Input x:Name="MediaStoragePathBox" Grid.Column="2" Text="{Binding MediaStoragePath, Mode=TwoWay}" Placeholder="媒体目录" IsEnabled="{Binding IsIdle}" />
                            <arc:Button Grid.Column="3" Classes="icon" Content="…" Click="OnMediaStorageBrowseClicked" IsEnabled="{Binding IsIdle}" ToolTip.Tip="选择媒体目录" />
                            <arc:Button Grid.Column="4" Content="保存读取" Command="{Binding SaveMediaStorageCommand}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,32,32" ColumnSpacing="6">
                        <TextBlock Text="本地目录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <arc:Button Grid.Column="1" Content="新增" Command="{Binding NewDirectoryCommand}" />
                        <arc:Button Grid.Column="2" Content="读取全部" Command="{Binding RescanCommand}" />
                        <TextBlock Grid.Column="3" Text="{Binding DirectoryPageText}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                        <arc:Button Grid.Column="4" Classes="icon" Content="‹" FontSize="20" Command="{Binding PreviousDirectoryPageCommand}" ToolTip.Tip="上一页" />
                        <arc:Button Grid.Column="5" Classes="icon" Content="›" FontSize="20" Command="{Binding NextDirectoryPageCommand}" ToolTip.Tip="下一页" />
                    </Grid>
                    <Border Grid.Row="2" Classes="card" Padding="6">
                        <ListBox x:Name="DirectoryList" ItemsSource="{Binding VisibleDirectorySources}" SelectedItem="{Binding SelectedDirectory}" IsEnabled="{Binding IsIdle}" SizeChanged="OnDirectoryViewportSizeChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                    <Border Grid.Row="3" Classes="card" Padding="10">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="130,*,32" ColumnSpacing="6">
                                <arc:Select x:Name="DirectoryKindPicker" ItemsSource="{Binding DirectoryKinds}" TextSelector="{x:Static converters:MusicSelectLabels.DirectoryKind}" SelectedItem="{Binding SelectedDirectoryKind}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
                                <arc:Input Grid.Column="1" Text="{Binding DirectoryPath}" Placeholder="目录路径" IsEnabled="{Binding IsIdle}" />
                                <arc:Button Grid.Column="2" Classes="icon" Content="…" Click="OnDirectoryBrowseClicked" IsEnabled="{Binding IsIdle}" ToolTip.Tip="选择目录" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <arc:Button Content="保存并读取" Classes="primary" Command="{Binding SaveDirectoryCommand}" />
                                <arc:Button Content="重新读取" Command="{Binding ScanDirectoryCommand}" />
                                <arc:Button Content="移除" Classes="quiet" Command="{Binding RemoveDirectoryCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="AccountsTab" Header="账号">
                <Grid Margin="0" RowDefinitions="40,*" RowSpacing="8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                        <arc:Button x:Name="AddEndpointButton" Content="添加接入点" Command="{Binding AddEndpointCardCommand}" VerticalAlignment="Center" />
                        <arc:Button Grid.Column="1" Content="同步全部" Classes="quiet" Command="{Binding SynchronizeAllCommand}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="在线模式" VerticalAlignment="Center" />
                            <arc:Switch x:Name="OnlineModeToggle" IsChecked="{Binding OnlineEnabled, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="在线模式" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="EndpointCardsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="EndpointCardsList" ItemsSource="{Binding EndpointCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EndpointCardViewModel">
                                    <views:EndpointCardView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="SettingsTab" Header="设置">
                <StackPanel Margin="0" Spacing="10">
                    <Border x:Name="AppearanceSettingsPanel" Classes="card" Padding="10">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8" ColumnDefinitions="80,*" ColumnSpacing="10">
                            <TextBlock Text="外观" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <arc:Select x:Name="AppearancePicker" Grid.Column="1" ItemsSource="{Binding AppearanceOptions}"
                                        TextSelector="{x:Static converters:MusicSelectLabels.Appearance}"
                                        SelectedItem="{Binding SelectedAppearanceOption, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="1" Text="列表格式" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <arc:Select x:Name="CardLayoutPicker" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CardLayoutChoices}"
                                        TextSelector="{x:Static converters:MusicSelectLabels.CardLayout}"
                                        SelectedItem="{Binding SelectedCardLayoutOption, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Border>
                    <Border x:Name="AudioSettingsPanel" Classes="card" Padding="10">
                        <Grid RowDefinitions="38,38,16" RowSpacing="8" ColumnDefinitions="80,*,38,Auto" ColumnSpacing="10">
                            <TextBlock Text="输出设备" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Grid.ColumnSpan="3" ColumnDefinitions="*,32" ColumnSpacing="6">
                                <arc:Select x:Name="OutputDevicePicker" ItemsSource="{Binding OutputDevices}" TextSelector="{x:Static converters:MusicSelectLabels.OutputDevice}" SelectedItem="{Binding SelectedOutputDevice}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanConfigureAudio}" />
                                <arc:Button Grid.Column="1" Classes="icon" Content="↻" FontSize="18" Command="{Binding RefreshOutputDevicesCommand}" ToolTip.Tip="刷新设备" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="音量" Classes="fieldLabel" VerticalAlignment="Center" />
                            <arc:Slider IsValueVisible="False" Grid.Row="1" Grid.Column="1" Value="{Binding Volume}" Minimum="0" Maximum="100" Height="32" VerticalAlignment="Center" UseLayoutRounding="False" IsEnabled="{Binding CanConfigureAudio}">
                            </arc:Slider>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <arc:Checkbox Grid.Row="1" Grid.Column="3" Content="静音" VerticalAlignment="Center" UseLayoutRounding="False" IsChecked="{Binding IsMuted}" IsEnabled="{Binding CanConfigureAudio}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding AudioOutputNotice}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AudioOutputNotice}" />
                        </Grid>
                    </Border>
                    <Border x:Name="CacheSettingsPanel" Classes="card" Padding="10">
                        <Grid RowDefinitions="Auto,Auto,Auto,38" RowSpacing="8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="本地音乐" FontWeight="SemiBold" />
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="64,*" ColumnSpacing="8">
                                <TextBlock Text="媒体目录" Classes="muted" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding AppliedMediaStoragePath}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AppliedMediaStoragePath}" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="64,*" ColumnSpacing="8">
                                <TextBlock Text="配置目录" Classes="muted" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding DataDirectory}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DataDirectory}" />
                            </Grid>
                            <arc:Select x:Name="LocalMediaCleanupPicker" Grid.Row="3" ItemsSource="{Binding LocalMediaCleanupChoices}"
                                        TextSelector="{x:Static converters:MusicSelectLabels.LocalMediaCleanup}"
                                        SelectedItem="{Binding SelectedLocalMediaCleanup, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <arc:Button Grid.Row="3" Grid.Column="1" Content="清理本地音乐" Command="{Binding CleanupLocalMediaCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12" Height="16">
            <TextBlock Text="{Binding PlaybackHint}" IsVisible="{Binding HasPlaybackHint}" Classes="muted" FontSize="11" MaxWidth="360" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PlaybackHint}" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" IsVisible="{Binding HasStatus}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
        </Grid>
        <Border x:Name="PlaybackBar" Grid.Row="3" Background="{DynamicResource MusicPanelBrush}" BorderBrush="{DynamicResource MusicLineBrush}" BorderThickness="{x:Static theme:MusicGeometry.OutlineThickness}" CornerRadius="12" Padding="14,10">
            <Grid RowDefinitions="40,48" RowSpacing="3">
                <Grid>
                    <Grid ColumnDefinitions="*,224,*">
                        <theme:MetadataTransition ChangeKey="{Binding PlaybackTitle}" SecondaryKey="{Binding PlaybackArtist}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="PlaybackMetadata" Spacing="3" VerticalAlignment="Center" ToolTip.Tip="{Binding AudioDetails}">
                                <TextBlock Text="{Binding PlaybackTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PlaybackArtist}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </theme:MetadataTransition>
                        <Grid x:Name="PlaybackVolume" Grid.Column="2" ColumnDefinitions="*,Auto,100" ColumnSpacing="8" Height="40" VerticalAlignment="Center">
                            <arc:Checkbox Grid.Column="1" Content="静音" VerticalAlignment="Center" UseLayoutRounding="False" IsChecked="{Binding IsMuted}" IsEnabled="{Binding CanConfigureAudio}" FontSize="11" />
                            <arc:Slider IsValueVisible="False" Grid.Column="2" Value="{Binding Volume}" Minimum="0" Maximum="100" Height="32" VerticalAlignment="Center" UseLayoutRounding="False" IsEnabled="{Binding CanConfigureAudio}" ToolTip.Tip="{Binding VolumeText}">
                            </arc:Slider>
                        </Grid>
                    </Grid>
                    <Grid x:Name="TransportGroup" Width="200" Height="40" ColumnDefinitions="40,40,40,40,40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <arc:Button x:Name="ShuffleButton" Classes="transport modeTransport" Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="{Binding ShuffleModeText}" AutomationProperties.Name="{Binding ShuffleModeText}">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="TransportShuffleIcon" Classes="modeGlyph" Classes.active="{Binding IsShuffle}" Data="{StaticResource ShuffleGlyph}" />
                            </Canvas>
                        </arc:Button>
                        <arc:Button x:Name="PreviousTrackButton" Grid.Column="1" Classes="transport" Command="{Binding PreviousCommand}" ToolTip.Tip="上一首" AutomationProperties.Name="上一首">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="TransportPreviousIcon" Data="M 3,2 L 5,2 L 5,14 L 3,14 Z M 13,2 L 5,8 L 13,14 Z" Fill="{DynamicResource MusicTextBrush}" Width="16" Height="16" Stretch="None" />
                            </Canvas>
                        </arc:Button>
                        <arc:Button x:Name="TransportButton" Grid.Column="2" Classes="primary transportPrimary" Command="{Binding TogglePlayPauseCommand}" Width="36" Height="36" MinHeight="0" Padding="0" CornerRadius="18" ToolTip.Tip="{Binding TransportButtonText}" AutomationProperties.Name="{Binding TransportButtonText}">
                            <theme:PlayPauseTransition x:Name="TransportGlyphTransition" IsPlaying="{Binding IsPlaying}" Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Path x:Name="TransportPlayIcon" Data="M 5,2 L 13,8 L 5,14 Z" Fill="{DynamicResource MusicAccentTextBrush}" Width="16" Height="16" Stretch="None" IsVisible="{Binding !IsPlaying}" />
                                    <Path x:Name="TransportPauseIcon" Data="M 4,2 L 7,2 L 7,14 L 4,14 Z M 9,2 L 12,2 L 12,14 L 9,14 Z" Fill="{DynamicResource MusicAccentTextBrush}" Width="16" Height="16" Stretch="None" IsVisible="{Binding IsPlaying}" />
                                </Canvas>
                            </theme:PlayPauseTransition>
                        </arc:Button>
                        <arc:Button x:Name="NextTrackButton" Grid.Column="3" Classes="transport" Command="{Binding NextCommand}" ToolTip.Tip="下一首" AutomationProperties.Name="下一首">
                            <Canvas Width="16" Height="16">
                                <Path x:Name="TransportNextIcon" Data="M 11,2 L 13,2 L 13,14 L 11,14 Z M 3,2 L 11,8 L 3,14 Z" Fill="{DynamicResource MusicTextBrush}" Width="16" Height="16" Stretch="None" />
                            </Canvas>
                        </arc:Button>
                        <arc:Button x:Name="RepeatButton" Grid.Column="4" Classes="transport modeTransport" Command="{Binding CycleRepeatModeCommand}" ToolTip.Tip="{Binding RepeatModeText}" AutomationProperties.Name="{Binding RepeatModeText}">
                            <Grid Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Path x:Name="TransportRepeatIcon" Classes="modeGlyph" Classes.active="{Binding IsRepeating}" Data="{StaticResource RepeatGlyph}" />
                                </Canvas>
                                <TextBlock Text="1" IsVisible="{Binding IsRepeatOne}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource MusicAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </arc:Button>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="42,*,42" ColumnSpacing="10">
                    <TextBlock Text="{Binding PositionText}" VerticalAlignment="Center" Classes="muted" FontSize="11" />
                    <arc:Slider IsValueVisible="False" x:Name="PlaybackTimeline" Grid.Column="1" Height="48" VerticalAlignment="Center" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" IsEnabled="{Binding CanSeek}" SmallChange="0.01" LargeChange="15" AutomationProperties.Name="播放进度" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center" HorizontalAlignment="Right" Classes="muted" FontSize="11" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
