<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:views="using:MajMusic.Presentation.Views"
             x:Class="MajMusic.Presentation.Views.DesktopSongDetailsView" x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="Border#DesktopDiscussionPane"><Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="1"/></Style>
        <Style Selector="Border#DesktopDiscussionPane.practiceFull">
            <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.RowSpan" Value="2"/><Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="ZIndex" Value="5"/>
        </Style>
        <Style Selector="TextBlock.detailMuted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MusicMutedBrush}" />
        </Style>
        <Style Selector="Border#DesktopDiscussionPane.preview">
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Border#DesktopDiscussionPane.preview.practiceFull">
            <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.commentComposer:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource MusicAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>
    <Grid x:Name="DesktopDetailsColumns" RowDefinitions="44,*" RowSpacing="10" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.65*" MinWidth="180" MaxWidth="280" />
            <ColumnDefinition Width="*" MinWidth="190" />
            <ColumnDefinition Width="0.65*" MinWidth="180" MaxWidth="280" />
        </Grid.ColumnDefinitions>
        <arc:Button Grid.Column="0" IsVisible="{Binding !IsChartFullscreen}" Classes="quiet" Content="‹ 返回" Command="{Binding CloseExpandedSongDetailsCommand}" HorizontalAlignment="Left" MinHeight="44" />
        <views:SongPreviewTabs IsVisible="{Binding !IsChartFullscreen}" x:Name="DesktopSongPreviewTabs" Grid.Column="1" Height="44" />
        <Grid Grid.Column="2" IsVisible="{Binding !IsChartFullscreen}" ColumnDefinitions="*,Auto,44" ColumnSpacing="6">
            <TextBlock Text="{Binding SongSocialAccountText}" Classes="detailMuted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <arc:Button Grid.Column="1" Classes="icon" Width="44" Height="44" Content="↻" FontSize="19" Command="{Binding RefreshSongSocialCommand}" IsVisible="{Binding IsSongSocialVisible}" ToolTip.Tip="刷新评论" AutomationProperties.Name="刷新评论" />
            <arc:Button x:Name="CloseExpandedSongDetailsButton" Grid.Column="2" Classes="icon" Width="44" Height="44" Command="{Binding CloseExpandedSongDetailsCommand}" ToolTip.Tip="收起详情" AutomationProperties.Name="收起详情">
                <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{DynamicResource MusicTextBrush}" StrokeThickness="1.7" Width="16" Height="16" Stretch="None" />
            </arc:Button>
        </Grid>
        <ContentControl x:Name="DesktopSongSummarySlot" IsVisible="{Binding !IsChartFullscreen}" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <Border x:Name="DesktopDiscussionPane" Classes.practiceFull="{Binding IsChartFullscreen}" Classes="card" Classes.preview="{Binding IsSongChartPreviewSelected}">
            <Border.Styles>
                <Style Selector="Border#DesktopDiscussionPane:not(.preview)">
                    <Setter Property="Padding" Value="12" />
                </Style>
            </Border.Styles>
            <Grid>
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6" IsVisible="{Binding !IsSongChartPreviewSelected}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding SongCommentCountText}" Classes="detailMuted" IsVisible="{Binding IsSongSocialVisible}" />
                        <TextBlock Grid.Column="1" Text="加载中" Classes="detailMuted" IsVisible="{Binding IsSongSocialLoading}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding SongSocialStatus}" Classes="detailMuted" IsVisible="{Binding HasSongSocialStatus}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <ListBox x:Name="SongCommentsList" Classes="songComments" Grid.Row="2" ItemsSource="{Binding SongComments}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:SongCommentItemViewModel"><views:SongCommentRow /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <arc:Button x:Name="LoadMoreSongCommentsButton" Grid.Row="3" Content="加载更多" MinHeight="44" Command="{Binding LoadMoreSongCommentsCommand}" IsVisible="{Binding HasMoreSongComments}" HorizontalAlignment="Center" />
                </Grid>
                <Border x:Name="ChartPreviewHost" IsVisible="{Binding IsSongChartPreviewSelected}" Background="{DynamicResource MusicRaisedBrush}" CornerRadius="12" ClipToBounds="True">
                    <views:ChartPreviewPane />
                </Border>
            </Grid>
        </Border>
        <Border x:Name="DesktopComposerPane" IsVisible="{Binding !IsChartFullscreen}" Grid.Row="1" Grid.Column="2" Classes="card" Padding="12">
            <Grid RowDefinitions="44,*" RowSpacing="8">
                <arc:Button x:Name="SongLikeButton" MinHeight="44" Command="{Binding ToggleSongLikeCommand}" IsEnabled="{Binding CanLikeSong}" IsVisible="{Binding IsSongSocialVisible}" AutomationProperties.Name="点赞" LabelSwapMode="None">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="赞" IsVisible="{Binding !IsSongLiked}" />
                        <TextBlock Text="已赞" IsVisible="{Binding IsSongLiked}" Foreground="{DynamicResource MusicAccentBrush}" />
                        <TextBlock Text="{Binding SongLikeText}" />
                    </StackPanel>
                </arc:Button>
                <Grid Grid.Row="1" RowDefinitions="Auto,*,44" RowSpacing="8" IsVisible="{Binding CanComposeSongComment}">
                    <Grid ColumnDefinitions="*,32" IsVisible="{Binding HasSongReplyTarget}">
                        <TextBlock Text="{Binding ReplyingToText}" Classes="detailMuted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <arc:Button Grid.Column="1" Classes="icon" Content="×" Width="32" Height="32" Command="{Binding CancelSongReplyCommand}" ToolTip.Tip="取消回复" AutomationProperties.Name="取消回复" />
                    </Grid>
                    <TextBox x:Name="SongCommentInput" Grid.Row="1" Classes="commentComposer" Text="{Binding SongCommentDraft, Mode=TwoWay}" PlaceholderText="写下评论" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="10000" MinHeight="66" Padding="12,10" CornerRadius="10" VerticalContentAlignment="Top" Background="{DynamicResource MusicRaisedBrush}" Foreground="{DynamicResource MusicTextBrush}" BorderBrush="{DynamicResource MusicLineBrush}" BorderThickness="1" FontSize="13" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding !IsSongCommentSending}" />
                    <arc:Button x:Name="PostSongCommentButton" Grid.Row="2" Content="发送" MinHeight="44" Command="{Binding PostSongCommentCommand}" IsEnabled="{Binding CanPostSongComment}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
