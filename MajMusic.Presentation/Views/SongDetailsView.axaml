<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="using:MajMusic.Presentation.ViewModels"
             xmlns:views="using:MajMusic.Presentation.Views"
             x:Class="MajMusic.Presentation.Views.SongDetailsView"
             x:Name="DetailsRoot" x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.detailMuted">
            <Setter Property="Foreground" Value="{DynamicResource MusicMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="arc|Button.detailAction">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="arc|Button.liked">
            <Setter Property="Foreground" Value="{DynamicResource MusicAccentBrush}" />
        </Style>
        <Style Selector="TextBox.commentComposer:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource MusicAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Grid.commentInputRow">
            <Setter Property="Height" Value="66" />
        </Style>
        <Style Selector="views|SongDetailsView.compactComposer Grid.commentInputRow">
            <Setter Property="Height" Value="44" />
        </Style>
    </UserControl.Styles>
    <Grid x:Name="SongDetailsTabs" RowDefinitions="Auto,*" RowSpacing="6" Margin="8,0,8,8">
        <views:SongPreviewTabs x:Name="SongPreviewSegments" ShowOverview="True" />
        <Grid Grid.Row="1" ClipToBounds="True">
            <ScrollViewer x:Name="SongOverviewPane" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="0,12,0,8">
                    <TextBlock Text="{Binding SelectedTrack.Description}" TextWrapping="Wrap" FontSize="13" />
                    <ItemsControl ItemsSource="{Binding SelectedTrack.Tags}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{DynamicResource MusicRaisedBrush}" CornerRadius="8" Padding="9,5" Margin="0,0,7,7">
                                    <TextBlock Text="{Binding .}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="8" IsVisible="{Binding IsSongSocialVisible}">
                        <TextBlock Text="{Binding SongSocialAccountText}" Classes="detailMuted" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SongSocialStatus}" IsVisible="{Binding HasSongSocialStatus}" Classes="detailMuted" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="SongCommentsLayout" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="4" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SongCommentCountText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="加载中" Classes="detailMuted" IsVisible="{Binding IsSongSocialLoading}" />
                    </StackPanel>
                    <arc:Button x:Name="SongLikeButton" Grid.Column="1" Classes="detailAction" Classes.liked="{Binding IsSongLiked}" Command="{Binding ToggleSongLikeCommand}" IsEnabled="{Binding CanLikeSong}" AutomationProperties.Name="点赞">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="赞" IsVisible="{Binding !IsSongLiked}" />
                            <TextBlock Text="已赞" IsVisible="{Binding IsSongLiked}" Foreground="{DynamicResource MusicAccentBrush}" />
                            <TextBlock Text="{Binding SongLikeText}" />
                        </StackPanel>
                    </arc:Button>
                    <arc:Button Grid.Column="2" Classes="icon" Width="44" Height="44" Content="↻" FontSize="19" Command="{Binding RefreshSongSocialCommand}" ToolTip.Tip="刷新评论" AutomationProperties.Name="刷新评论" />
                    <arc:Button x:Name="LoadMoreSongCommentsButton" Grid.Column="3" Classes="icon" Width="44" Height="44" Content="⋯" FontSize="20" Command="{Binding LoadMoreSongCommentsCommand}" IsVisible="{Binding HasMoreSongComments}" ToolTip.Tip="加载更多评论" AutomationProperties.Name="加载更多评论" />
                </Grid>
                <TextBlock x:Name="SongCommentsStatus" Grid.Row="1" Text="{Binding SongSocialStatus}" IsVisible="{Binding HasSongSocialStatus}" Classes="detailMuted" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SongSocialStatus}" />
                <ListBox x:Name="SongCommentsList" Classes="songComments" Grid.Row="2" ItemsSource="{Binding SongComments}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongCommentItemViewModel"><views:SongCommentRow /></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="3" ColumnDefinitions="*,44" ColumnSpacing="8" IsVisible="{Binding HasSongReplyTarget}">
                    <TextBlock Text="{Binding ReplyingToText}" Classes="detailMuted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <arc:Button Grid.Column="1" Classes="icon" Width="44" Height="44" Content="×" Command="{Binding CancelSongReplyCommand}" ToolTip.Tip="取消回复" AutomationProperties.Name="取消回复" />
                </Grid>
                <Grid Grid.Row="4" Classes="commentInputRow" ColumnDefinitions="*,64" ColumnSpacing="8" IsVisible="{Binding CanComposeSongComment}">
                    <TextBox x:Name="SongCommentInput" Classes="commentComposer" Text="{Binding SongCommentDraft, Mode=TwoWay}" PlaceholderText="写下评论" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="10000" Padding="12,10" CornerRadius="10" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Background="{DynamicResource MusicRaisedBrush}" Foreground="{DynamicResource MusicTextBrush}" BorderBrush="{DynamicResource MusicLineBrush}" BorderThickness="1" FontSize="13" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding !IsSongCommentSending}" />
                    <arc:Button x:Name="PostSongCommentButton" Grid.Column="1" Classes="detailAction" Content="发送" Command="{Binding PostSongCommentCommand}" IsEnabled="{Binding CanPostSongComment}" VerticalAlignment="Stretch" />
                </Grid>
            </Grid>
            <Border x:Name="ChartPreviewHost" Background="{DynamicResource MusicRaisedBrush}" CornerRadius="12" ClipToBounds="True" IsVisible="False">
                <views:ChartPreviewPane />
            </Border>
        </Grid>
    </Grid>
</UserControl>
