<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishDir>$(MSBuildProjectDirectory)/../artifacts/publish/win-x64/</PublishDir>
        <UseAppHost>true</UseAppHost>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <DebugType>None</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
        <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
        <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    </PropertyGroup>

    <Target Name="ExcludeWindowsNativeSymbols" AfterTargets="ResolvePackageAssets">
        <!-- Native symbol assets must also be omitted from the generated dependency manifest. -->
        <ItemGroup>
            <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.Extension)' == '.pdb'" />
            <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.Extension)' == '.pdb'" />
        </ItemGroup>
    </Target>

    <Target Name="ExcludeWindowsPublishSymbols" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
        </ItemGroup>
    </Target>
</Project>
