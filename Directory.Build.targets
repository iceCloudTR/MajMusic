<Project>
  <!-- Arc's packaged controls already contain their generated assets. MajMusic defines no Arc token generators. -->
  <Target Name="ExcludeUnusedArcFoundationGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'TKCode.Arc.Foundation.Generators'" />
    </ItemGroup>
  </Target>
</Project>
