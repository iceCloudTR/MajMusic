+using System;
+using UnityEditor;
+using UnityEditor.Build.Reporting;
+
+public static class MajMusicWebBuild
+{
+    public static void Build()
+    {
+        var arguments = Environment.GetCommandLineArgs();
+        var output = Array.IndexOf(arguments, "-majViewOutput");
+        if (output < 0 || output + 1 == arguments.Length)
+        {
+            throw new ArgumentException("Provide a build directory with -majViewOutput.");
+        }
+
+        PlayerSettings.WebGL.compressionFormat = WebGLCompressionFormat.Disabled;
+        var report = BuildPipeline.BuildPlayer(new BuildPlayerOptions
+        {
+            scenes = new[] { "Assets/Scenes/Main.unity" },
+            locationPathName = arguments[output + 1],
+            target = BuildTarget.WebGL,
+            options = BuildOptions.None
+        });
+        if (report.summary.result != BuildResult.Succeeded)
+        {
+            throw new InvalidOperationException($"MajView build result: {report.summary.result}.");
+        }
+    }
+}
