diff --git a/Assets/Scripts/UI/EmbeddedViewport.cs b/Assets/Scripts/UI/EmbeddedViewport.cs
new file mode 100644
index 0000000..1908211
--- /dev/null
+++ b/Assets/Scripts/UI/EmbeddedViewport.cs
@@ -0,0 +1,45 @@
+using System.Runtime.InteropServices;
+using UnityEngine;
+
+[RequireComponent(typeof(Camera))]
+public sealed class EmbeddedViewport : MonoBehaviour
+{
+    // CanvasMain is scaled from a 108-unit square. Reserve room for its anchored controls.
+    private const float ReferenceSize = 108f;
+    private const float HeaderHeight = 10f;
+    private const float TransportHeight = 15f;
+
+    private Camera chartCamera;
+    private Vector2Int screenSize;
+
+    [DllImport("__Internal")]
+    private static extern void MajMusicSetViewport(float left, float top, float width, float height);
+
+    private void Awake()
+    {
+        chartCamera = GetComponent<Camera>();
+        chartCamera.aspect = 1f;
+    }
+
+    private void LateUpdate()
+    {
+        var size = new Vector2Int(Screen.width, Screen.height);
+        if (size == screenSize)
+        {
+            return;
+        }
+
+        screenSize = size;
+        var scale = Mathf.Min(size.x, size.y) / ReferenceSize;
+        var header = HeaderHeight * scale;
+        var transport = TransportHeight * scale;
+        var contentHeight = size.y - header - transport;
+        var side = Mathf.Floor(Mathf.Min(size.x, contentHeight));
+        var viewport = new Rect((size.x - side) / 2f, transport + (contentHeight - side) / 2f, side, side);
+        chartCamera.pixelRect = viewport;
+
+#if UNITY_WEBGL && !UNITY_EDITOR
+        MajMusicSetViewport(viewport.x / size.x, 1f - viewport.yMax / size.y, side / size.x, side / size.y);
+#endif
+    }
+}
